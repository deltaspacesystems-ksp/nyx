<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Per-user installer: no administrator rights, installs to %LOCALAPPDATA%\Programs\Nyx. -->
  <Package Name="Nyx" Manufacturer="Nyx" Version="$(var.Version)" UpgradeCode="6f0b6a52-3d0e-4d2e-9a53-2c1c7f4ab001" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Nyx is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="app.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Nyx" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Nyx" Level="1">
      <Files Include="$(var.Src)\**">
        <Exclude Files="$(var.Src)\nyx.exe" />
      </Files>
      <Component Id="MainExe" Directory="INSTALLFOLDER" Bitness="always64">
        <File Id="NyxExe" Source="$(var.Src)\nyx.exe" KeyPath="yes" />
      </Component>
      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <Shortcut Id="StartShortcut" Name="Nyx" Target="[INSTALLFOLDER]nyx.exe" WorkingDirectory="INSTALLFOLDER" Icon="app.ico" />
        <RegistryValue Root="HKCU" Key="Software\Nyx" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
